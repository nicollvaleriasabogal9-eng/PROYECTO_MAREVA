--- TRIGGERS: SINCRONIZACIÓN AUTOMÁTICA DE CUPOS ---

CREATE OR REPLACE FUNCTION fn_descontar_cupos() RETURNS TRIGGER AS $$
DECLARE
    total_personas INT := NEW.cant_adultos + NEW.cant_menores;
BEGIN
    UPDATE paquete_turistico
       SET cupos_disponibles = cupos_disponibles - total_personas
     WHERE id_paquete = NEW.id_paquete
       AND cupos_disponibles >= total_personas;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'CUPOS_INSUFICIENTES: no hay cupos disponibles para el paquete %', NEW.id_paquete;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_descontar_cupos
    AFTER INSERT ON reserva
    FOR EACH ROW EXECUTE FUNCTION fn_descontar_cupos();

CREATE OR REPLACE FUNCTION fn_devolver_cupos() RETURNS TRIGGER AS $$
BEGIN
    IF NEW.estado = 'cancelada' AND OLD.estado <> 'cancelada' THEN
        UPDATE paquete_turistico
           SET cupos_disponibles = cupos_disponibles + (NEW.cant_adultos + NEW.cant_menores)
         WHERE id_paquete = NEW.id_paquete;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_devolver_cupos
    AFTER UPDATE ON reserva
    FOR EACH ROW EXECUTE FUNCTION fn_devolver_cupos();

